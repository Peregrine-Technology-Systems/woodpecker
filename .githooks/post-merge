#!/usr/bin/env bash
# peregrine-vault-hook: post-merge — verify_hooks.py's ownership marker (#392).
# post-merge/post-checkout are exactly where git-lfs installs its own smudge
# hooks. Without a marker, a repo whose hook is git-lfs's — never ours —
# renders identically in verify_hooks.py to one whose vault hook is
# genuinely installed and simply has no known-bad input to prove it fires.
# Found by group-marketing verifying #386 from the consuming side.
#
# Relink vault mirrors after git rewrites files underneath them (#319).
#
# Hard links do not only break on clone. **Any git operation that rewrites a
# linked file severs it** — merge, pull, a checkout where the file differs, a
# rebase. git writes a new inode and moves it into place; the canonical path
# gets the new content and the mirror keeps the old one, and *nothing looks
# wrong*: both paths exist, both are readable, and `git status` is clean.
#
# Measured on both sides of this convention on 2026-08-14: one merge severed
# 4 of 16 mirrors in `peregrine-group-marketing`, and a single `git pull`
# severed all 30 here.
#
# Installed at `post-merge` and `post-checkout`, which is exactly where
# `git-lfs` puts its own smudge hooks — the mechanism is proven, not
# speculative.
#
# Silent on success, and quiet even when repairing: it names the mirrors it
# relinked, not the 30 it found healthy. A hook that narrates every merge
# trains people to stop reading hooks.
#
# Reads the INSTALLED copy, never global-claude's live working tree (#386) —
# ~/.claude/.hook-runtime/, published by that repo's own hooks from git
# HEAD, so this can never observe a multi-file edit in progress there.
#
# git-lfs and the vault relink CHAIN, not compete for this slot (#562).
# group-marketing found the exclusive version the wrong way round: in a repo
# where git-lfs got the slot first, the vault relink never installed at all
# and verify_hooks.py's old `absent` verdict read as harmless — weeks of
# manual relinking, unexplained, because nothing looked wrong enough to
# investigate. lfs runs FIRST: its smudge REWRITES the file the relink
# depends on, so relinking before lfs runs would fix a file lfs is about to
# unlink anyway. The relink always runs after, regardless of lfs's own exit
# code, so a missing or failing git-lfs binary can never also silently
# disable the vault half.
#
# Gated on the REPO declaring LFS via a committed `.gitattributes`
# (`filter=lfs`), never on whether the `git-lfs` binary happens to be on
# this machine's PATH: `git config filter.lfs.clean` is set machine-wide by
# `git lfs install`, not per-repo, so it cannot tell an LFS-adopting repo
# from a plain one on a machine that has git-lfs installed at all — and
# this template ships to ~70 repos, most of which never use LFS. Probing
# `.gitattributes` keeps every non-LFS repo silent regardless of what's on
# the machine.

# Repo-local steps run LAST, on every exit path (the vault and lfs steps below
# exit early), and never change the hook's exit status (#880, #879). A repo
# extends this hook by dropping executables into .githooks/post-merge.d/
# instead of editing this shared copy: an absent directory is a no-op, so the
# repos that adopt the template unchanged behave byte-identically.
run_local_steps() {
    local rc=$?
    local top
    top=$(git rev-parse --show-toplevel 2>/dev/null) || return $rc
    # Only the primary checkout cleans up worktrees, never a linked one (#879).
    if [ -f "$top/scripts/worktree_cleanup.py" ] \
        && [ "$(git rev-parse --git-dir 2>/dev/null)" = "$(git rev-parse --git-common-dir 2>/dev/null)" ]; then
        (cd "$top" && python3 scripts/worktree_cleanup.py --apply --quiet) \
            || echo "post-merge: scripts/worktree_cleanup.py exited non-zero" >&2
    fi
    local step
    for step in "$top"/.githooks/post-merge.d/*; do
        [ -f "$step" ] && [ -x "$step" ] || continue
        "$step" "$@" || echo "post-merge: ${step##*/} exited non-zero" >&2
    done
    return $rc
}
trap 'run_local_steps' EXIT

set -uo pipefail

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

lfs_rc=0
if git -C "$root" grep -q -I -e "filter=lfs" -- '*.gitattributes' 2>/dev/null; then
    if command -v git-lfs >/dev/null 2>&1; then
        git lfs post-merge "$@" || lfs_rc=$?
    else
        printf >&2 '\n%s\n\n' "This repository is set up to use Git LFS, but 'git-lfs' was not found on this machine's PATH. LFS-tracked files were not smudged."
        lfs_rc=2
    fi
fi

[ -f "$root/.vault-links.json" ] || exit $lfs_rc

linker="$HOME/.claude/.hook-runtime/link_vault.py"
if [ ! -f "$linker" ]; then
    echo "vault: $linker not found — mirrors may be stale; skipping relink" >&2
    exit $lfs_rc                # never block a merge over a missing helper
fi

# --verify first, so the common case (nothing severed) stays silent.
if python3 "$linker" --verify --quiet >/dev/null 2>&1; then
    exit $lfs_rc
fi

echo "vault: mirrors severed by this git operation — relinking" >&2
python3 "$linker" --quiet >&2 || echo "vault: relink FAILED — run link_vault.py by hand" >&2
exit $lfs_rc                    # a failed relink must not fail the merge
